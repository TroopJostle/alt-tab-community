<?xml version="1.0" standalone="yes"?>
<!--
  Intentionally empty.

  This fork does not ship Sparkle updates. `SUPublicEDKey` in Info.plist is upstream's
  (lwouis/alt-tab-macos) EdDSA public key, and we don't hold the matching private key, so
  no build produced from this repository could ever pass Sparkle's signature check.

  Previously this file was a verbatim copy of upstream's appcast: every <enclosure> pointed at
  github.com/lwouis/alt-tab-macos/releases/..., so "Install Update" would have silently replaced
  a community build with a stock upstream one. An empty channel makes Sparkle report
  "you're up to date" (SUAppcastDriver falls through to didNotFindUpdate when no item is newer),
  which is the correct answer for this fork.

  Do not repopulate this file from upstream. If this fork ever ships its own signed releases,
  generate a NEW EdDSA keypair, replace SUPublicEDKey, and write entries pointing at this
  repository's own release assets.
-->
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" version="2.0">
  <channel>
    <title>alt-tab-community</title>
    <language>en</language>
  </channel>
</rss>
